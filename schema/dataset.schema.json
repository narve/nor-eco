{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset.yaml for a hierarchical (fact-table) dataset",
  "type": "object",
  "required": ["id", "title", "unit", "claim_level", "source_ids", "dimensions"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "price_basis": {"enum": ["løpende", "faste", "ikke-relevant"]},
    "base_year": {"type": "integer"},
    "claim_level": {"enum": ["offisiell", "utledet", "estimat"]},
    "derivation": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "dimensions": {
      "description": "Ordered list of dimension ids; each is a column in facts.csv and a key in dimensions.yaml.",
      "type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true
    },
    "default_dimension": {"type": "string"},
    "published_totals": {
      "description": "Totals as published by the source, per period. The sum of facts must match within `tolerance` (relative).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["period", "value", "source_id"],
        "additionalProperties": false,
        "properties": {
          "period": {"type": "string"},
          "status": {"type": "string"},
          "value": {"type": "number"},
          "source_id": {"type": "string"}
        }
      }
    },
    "tolerance": {"type": "number", "minimum": 0, "default": 0.001},
    "notes": {"type": "string"},
    "breaks": {
      "type": "array",
      "items": {"type": "object", "required": ["period", "note"], "additionalProperties": false,
        "properties": {"period": {"type": "string"}, "note": {"type": "string"}, "source_id": {"type": "string"}}}
    }
  }
}
