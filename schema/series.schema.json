{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Processed series (plain time series)",
  "type": "object",
  "required": ["id", "title", "unit", "claim_level", "source_ids", "values"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "price_basis": {"enum": ["løpende", "faste", "ikke-relevant"]},
    "base_year": {"type": "integer"},
    "claim_level": {"enum": ["offisiell", "utledet", "estimat"]},
    "derivation": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "vintage": {"type": "string"},
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["period", "value"],
        "additionalProperties": false,
        "properties": {
          "period": {"type": "string", "pattern": "^[0-9]{4}(-(Q[1-4]|[0-9]{2}))?$"},
          "value": {"type": ["number", "null"]},
          "status": {"enum": ["regnskap", "saldert", "vedtatt", "budsjett", "forslag", "anslag", "foreløpig"]},
          "claim_level": {"enum": ["offisiell", "utledet", "estimat"]}
        }
      }
    },
    "notes": {"type": "string"},
    "breaks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["period", "note"],
        "additionalProperties": false,
        "properties": {"period": {"type": "string"}, "note": {"type": "string"}, "source_id": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"claim_level": {"enum": ["utledet", "estimat"]}}},
      "then": {"required": ["derivation"]}
    }
  ]
}
